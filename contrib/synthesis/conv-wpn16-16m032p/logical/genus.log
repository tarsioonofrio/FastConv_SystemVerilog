@file(logical_synthesis.tcl) 14: set HDL_FILES ""
@file(logical_synthesis.tcl) 16: if { [file exists $file_list_path] } {
    set fp [open $file_list_path r]
    while { [gets $fp line] >= 0 } {
        set line_trim [string trim $line]
