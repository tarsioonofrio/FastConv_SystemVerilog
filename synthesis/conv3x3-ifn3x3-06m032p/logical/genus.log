        set line_trim [string range $line_trim 8 end]
        if { $line_trim ne "" && [string first "=" $line_trim] > 0 } {
            set DEFINE_FLAGS "$DEFINE_FLAGS $line_trim "
        }
    }
    close $fp_def
}
