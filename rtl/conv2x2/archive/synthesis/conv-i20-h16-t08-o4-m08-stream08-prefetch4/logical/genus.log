        set line_trim [string trim $line]
        if {$line_trim eq "" || [string match "#*" $line_trim]} {
            continue
        }
        lappend HDL_FILES [resolve_project_file $line_trim $CONFIG_ROOT $GIT_ROOT]
    }
    close $fp
}
@file(logical_synthesis.tcl) 75: set defines_file [file join $CONFIG_ROOT list-define.txt]
@file(logical_synthesis.tcl) 76: set DEFINE_FLAGS [list]
