            lappend TOP_PARAMETERS $line_trim
        }
    }
    close $fp_parameters
}
@file(logical_synthesis.tcl) 48: proc resolve_project_file ...
@file(logical_synthesis.tcl) 60: set file_list_path [file join $CONFIG_ROOT list-file.txt]
