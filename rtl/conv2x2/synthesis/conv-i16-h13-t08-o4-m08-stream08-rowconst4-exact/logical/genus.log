        if {$line_trim ne "" && ![string match "#*" $line_trim]} {
            lappend TOP_PARAMETERS $line_trim
        }
    }
    close $fp_parameters
}
@file(logical_synthesis.tcl) 48: proc resolve_project_file ...
@file(logical_synthesis.tcl) 60: set file_list_path [file join $CONFIG_ROOT list-file.txt]
@file(logical_synthesis.tcl) 61: set HDL_FILES [list]
@file(logical_synthesis.tcl) 62: if {[file exists $file_list_path]} {
    set fp [open $file_list_path r]
