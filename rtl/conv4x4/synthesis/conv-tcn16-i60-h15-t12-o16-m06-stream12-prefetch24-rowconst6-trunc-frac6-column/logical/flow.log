@file(logical_synthesis.tcl) 17: set TOP_MODULE system
@file(logical_synthesis.tcl) 18: set top_file [file join $CONFIG_ROOT top-module.txt]
@file(logical_synthesis.tcl) 19: if {[file exists $top_file]} {
    set fp_top [open $top_file r]
    while {[gets $fp_top line] >= 0} {
        set line_trim [string trim $line]
        if {$line_trim ne "" && ![string match "#*" $line_trim]} {
            set TOP_MODULE $line_trim
            break
        }
    }
    close $fp_top
}
@file(logical_synthesis.tcl) 33: set TOP_PARAMETERS [list]
@file(logical_synthesis.tcl) 34: set parameters_file [file join $CONFIG_ROOT top-parameters.txt]
@file(logical_synthesis.tcl) 35: if {[file exists $parameters_file]} {
    set fp_parameters [open $parameters_file r]
    while {[gets $fp_parameters line] >= 0} {
        set line_trim [string trim $line]
        if {$line_trim ne "" && ![string match "#*" $line_trim]} {
            if {![regexp {^([A-Za-z_][A-Za-z0-9_]*)=(.+)$} $line_trim -> parameter_name parameter_value]} {
                error "invalid top parameter override in $parameters_file: $line_trim"
            }
            lappend TOP_PARAMETERS [list $parameter_name $parameter_value]
        }
    }
    close $fp_parameters
}
@file(logical_synthesis.tcl) 51: proc resolve_project_file ...
@file(logical_synthesis.tcl) 63: set file_list_path [file join $CONFIG_ROOT list-file.txt]
@file(logical_synthesis.tcl) 64: set HDL_FILES [list]
@file(logical_synthesis.tcl) 65: if {[file exists $file_list_path]} {
